# Company defaults for the jira-cli skill.
#
# This file is NOT part of the public skill repo. The company provisions it on
# each developer machine (dotfiles, MDM, onboarding script) so that a dev only
# has to paste their personal API token.
#
# Copy it to:
#   ~/.config/jira-cli-skills/defaults.env
#
# It is parsed with a key whitelist (never executed), so only these keys are
# read:
#
#   JIRA_SERVER        Base URL, no path. e.g. https://acme.atlassian.net
#   JIRA_LOGIN         Atlassian account email. Optional: falls back to
#                      `git config --global user.email`.
#   JIRA_INSTALLATION  cloud | local            (default: cloud)
#   JIRA_AUTH_TYPE     basic | bearer | mtls    (default: basic)
#   JIRA_PROJECT       Default project key. Optional: auto-discovered.
#   JIRA_BOARD         Default board name. Optional: auto-discovered.
#
# Environment variables and CLI flags always win over this file.

JIRA_SERVER=https://acme.atlassian.net
JIRA_LOGIN=you@acme.com
JIRA_INSTALLATION=cloud
JIRA_AUTH_TYPE=basic
# JIRA_PROJECT=
# JIRA_BOARD=
